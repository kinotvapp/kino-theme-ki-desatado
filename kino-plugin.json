{
  "id": "theme-ki-desatado",
  "name": "Ki Desatado",
  "version": "1.0.3",
  "apiVersion": 18,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Naranja de combate sobre azul noche, para quien entrena más allá de su límite.",
  "author": "kinotvapp",
  "hosts": [],
  "categories": [
    "themes"
  ],
  "capabilities": [
    "screen"
  ],
  "screen": {
    "label": "Ki Desatado",
    "labelEn": "Unleashed Ki",
    "opensFrom": [
      "settings"
    ],
    "settingsButton": {
      "label": "Ver presentación",
      "labelEn": "See presentation"
    }
  },
  "appThemes": [
    {
      "id": "ki-desatado",
      "name": {
        "es": "Ki Desatado",
        "en": "Unleashed Ki"
      },
      "colors": {
        "accent": "#FF8A1F",
        "onAccent": "#1C0B00",
        "background": "#0A1230",
        "surface": "#131D45",
        "surfaceHigh": "#1E2A5C",
        "railPanel": "#0E1738"
      },
      "shape": {
        "cardRadius": 20,
        "channelRadius": 20,
        "buttonRadius": 26,
        "chipRadius": 24,
        "dialogRadius": 22,
        "inputRadius": 14
      },
      "typography": {
        "scale": 1.0,
        "titleScale": 1.15
      },
      "tv": {
        "typography": {
          "scale": 1.0
        }
      },
      "adjustable": {
        "colors.accent": {
          "swatches": [
            "#FF8A1F",
            "#FFD23F",
            "#4F9BFF"
          ]
        },
        "shape.cardRadius": {
          "min": 0,
          "max": 32
        },
        "typography.scale": {
          "min": 1.0,
          "max": 1.3
        }
      },
      "background": {
        "type": "gradient",
        "colors": [
          "#0A1230",
          "#1A2C78"
